# database.env.example
# ==============================================================================
# Connection configuration for Data Import Agent
#
# Copy this file to `database.env` (which is gitignored) and update the values.
# The importer requires a connection entry named "importer" pointing to the
# control database.
#
# Authentication Modes:
#   1. SQL Server Auth: set "UN": "<username>", "PW": "<password>"
#      (or set "UN" here and provide password via IMPORTER_PASSWORD environment variable)
#   2. Windows Integrated Auth: set "trusted": "yes"
#   3. Entra ID / Azure AD: set "UN": "<user@domain.com>" (omit PW)
# ==============================================================================

# Example for SQL Server Authentication (e.g. sql1 VM):
# databases = '{"importer": {"type": "mssql", "server": "sql1", "database": "import_agent_dev", "UN": "sa", "PW": "YourPassword123!"}}'

# Example for Windows Integrated Authentication:
databases = '{"importer": {"type": "mssql", "server": "localhost", "database": "import_agent_dev", "trusted": "yes"}}'
