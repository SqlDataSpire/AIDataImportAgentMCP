# .env.example
# ==============================================================================
# Environment variables for Data Import Agent
# ==============================================================================

# Directory where database.env lives (defaults to repository root)
# IMPORTER_HOME=/path/to/importer

# Optional direct SQLAlchemy connection URL (alternative to database.env)
# IMPORTER_DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=import_agent_dev;Trusted_Connection=yes;TrustServerCertificate=yes

# Custom ODBC Driver for SQL Server (defaults to "ODBC Driver 18 for SQL Server")
# MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Data Guard Mode:
#   auto (default): guard data access only while an `importer mcp` server is running
#   on: always prompt before direct access to data files
#   off: disable data guard
# IMPORTER_DATA_GUARD=auto

# Optional additional locations (regex) to guard against unauthorized model tool access
# IMPORTER_DATA_LOCATIONS=\\\\sharedserver\\drop|/mnt/data

# Optional additional raw database/schema names (regex) to guard
# IMPORTER_GUARDED_SCHEMAS=my_warehouse_[a-z0-9_]+
